OPENAI_API_KEY=
# Voice model (full duplex). Its work (tools, search, memory) is answered by the core with OpenRouter models, see below.
OPENAI_LIVE_MODEL=gpt-live-1
# Required: the core answers GPT-Live delegations with OpenRouter models; without it calls are refused.
# Also used by Jev and «Работа».
OPEN_ROUTER_API_KEY=
# IANA time zone for the current_time tool. Defaults to the Mac's zone.
# Set it explicitly on Railway: containers run in UTC.
# ASSISTANT_TIMEZONE=Europe/Berlin
HOST=127.0.0.1
PORT=8787
# Required if exposing the core beyond localhost. Use HTTPS and set the same token in the app.
# BRIDGE_TOKEN=
# Memory: text model for extraction and consolidation, storage directory. Transcription is built into GPT-Live.
# Memory through OpenRouter: extraction after a call, and the dream / character review.
# MEMORY_MODEL=anthropic/claude-sonnet-5
# MEMORY_DEEP_MODEL=anthropic/claude-opus-5.5
# MEMORY_DIR=data
# Web search: the core's web_search tool (CLIENT_SEARCH_MODEL with OpenRouter's web plugin). WEB_SEARCH=off removes it.
# WEB_SEARCH=on
# Latency metrics: one JSON per call with event timings, no conversation text. Summary: npm run metrics.
# METRICS=on
# METRICS_DIR=data/metrics
# Jev (TypeSafe AI) prefetch: guesses read-only tools and goodbyes from the user's transcript.
# Sends the last turns of the transcript to api.typesafe.ai (or through OpenRouter). Without a key it is off.
# Either key works; TYPESAFE_API_KEY wins if both are set. Model defaults: jev-latest / typesafe/jev-1.13.
# on (default with a key) = act on Jev's decisions; shadow = only record them in metrics.
# TYPESAFE_API_KEY=
# JEV_MODE=on
# JEV_MODEL=
# Delegation models (OpenRouter names). Jev routes each request: simple read tools answer without a model,
# otherwise the model of the task tier gets only the chosen pack of tools (docs/tools-routing.md).
# CLIENT_MODEL_SIMPLE=google/gemini-3.5-flash-lite
# CLIENT_MODEL_STANDARD=openai/gpt-5.6-luna
# CLIENT_SEARCH_MODEL=google/gemini-3.5-flash-lite
# JEV_TOOL_THRESHOLD=0.8
# JEV_GOODBYE_THRESHOLD=0.9
# Trust in Jev's pack and tier choice; below it the request goes to the standard tier with all tools.
# JEV_ROUTE_THRESHOLD=0.6
# «Работа» (needs HELM_TOKEN, or HELM_CLOUD_URL with HELM_INTERNAL_TOKEN, and OPEN_ROUTER_API_KEY): an agent in Helm does long work, the result comes back as a call from Volna,
# a notification, or in the next call. Push needs an APNs key (.p8) from Apple Developer; see docs/device-setup.md.
# TASKS=on
# Сводка «что сейчас происходит» в задании: дешёвая модель раз в N секунд; 0 выключает.
# TASK_PROGRESS_MODEL=google/gemini-3.5-flash-lite
# TASK_PROGRESS_SECONDS=30
# Приветствие звонка: фраза из набора по времени суток и давности звонка (npm run greetings); off — запасное правило.
# GREETING=on
# APNS_KEY_PATH=data/apns.p8
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=dev.prototype.callassistant

# T3 Code (docs/core.md, 4l): with a token «Работа» runs as threads in T3 Code on this Mac. Issue the token once on the Mac:
#   t3 auth session issue --label volna --ttl 30d --token-only
# Port: ~/.t3/userdata/server-runtime.json. Work tasks go to a T3 project for T3_PROJECT_DIR (created if missing).
# T3_INSTANCE: claudeAgent (default) or codex; T3_MODEL empty = the project's model or claude-opus-5-5 / gpt-6-astra.
# T3_RUNTIME_MODE: auto (default), auto-accept-edits or approval-required; full-access is never used.
# T3_TOKEN=
# T3_URL=http://127.0.0.1:3773
# T3_PROJECT_DIR=~/Documents/Volna Work
# New projects by voice are created only as new empty folders here:
# T3_NEW_PROJECTS_DIR=~/Documents
# T3_INSTANCE=claudeAgent
# T3_MODEL=
# T3_RUNTIME_MODE=auto
# Long work in T3 (docs/task-sync.md): a task may run up to T3_TASK_MAX_MINUTES; a thread without any change for
# T3_STALL_MINUTES fails as t3_stalled (waiting for the owner does not count).
# T3_TASK_MAX_MINUTES=120
# T3_STALL_MINUTES=20

# Консоль ядра (docs/core.md, 4k): страница только на этом Mac, история последних 30 звонков в MEMORY_DIR/console.
# CONSOLE=on
# CONSOLE_PORT=25452

# Учёт расходов (docs/core.md, 4o): каждый платный вызов пишется в MEMORY_DIR/usage/YYYY-MM.jsonl, консоль показывает
# «Сводку» и «Расходы». Цена минуты GPT-Live (gpt-live-1: $0,05, посекундно). OpenRouter присылает цену сам.
# LIVE_PRICE_PER_MINUTE=0.05
# Сверка со счётом OpenAI: ключ администратора (platform.openai.com → Organization → Admin keys), ядро только читает
# Costs API. Не тот ключ, что OPENAI_API_KEY. Проект — если считать только его (proj_...).
# OPENAI_ADMIN_KEY=
# OPENAI_COSTS_PROJECT=
