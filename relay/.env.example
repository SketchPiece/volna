# «Узел» (docs/relay.md): помощник на Mac, через которого ядро в облаке работает со «Штурвалом».
# Адрес ядра. «Узел» сам ходит к нему, входящих портов на Mac нет.
CORE_URL=https://your-core.example.com
# Общий секрет с ядром (RELAY_TOKEN в переменных Railway). Сгенерировать: openssl rand -hex 32
RELAY_TOKEN=
# Токен «Штурвала», выдаётся на этом Mac (из папки репозитория t3code):
#   node apps/server/dist/bin.mjs auth session issue --base-dir ~/.helm --label volna-relay --ttl 365d --token-only
# Никуда не уходит. Старое имя T3_TOKEN тоже читается.
HELM_TOKEN=
# Папка данных «Штурвала»; адрес берётся из <папка>/userdata/server-runtime.json при каждом запросе.
# HELM_HOME=~/.helm
# HELM_URL=http://127.0.0.1:3783
